// Prisma schema for Diagramlab

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  authProvider String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]
  revisions    DiagramRevision[]

  @@map("users")
}

model Project {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  diagrams    Diagram[]
  chatSessions ChatSession[]

  @@index([ownerId])
  @@map("projects")
}

model Diagram {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  diagramType   String
  mermaidCode   String   @db.Text
  mermaidConfig Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions     DiagramRevision[]
  chatSessions  ChatSession[]

  @@index([projectId])
  @@index([diagramType])
  @@map("diagrams")
}

model DiagramRevision {
  id            String   @id @default(cuid())
  diagramId     String
  mermaidCode   String   @db.Text
  mermaidConfig Json     @default("{}")
  authorId      String?
  createdAt     DateTime @default(now())

  diagram       Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([diagramId])
  @@index([authorId])
  @@map("diagram_revisions")
}

model ChatSession {
  id         String   @id @default(cuid())
  projectId  String
  diagramId  String?
  model      String
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  diagram    Diagram? @relation(fields: [diagramId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]

  @@index([projectId])
  @@index([diagramId])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        String
  content     String   @db.Text
  mermaidCode String?  @db.Text
  createdAt   DateTime @default(now())

  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}
