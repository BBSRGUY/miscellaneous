// Counter App - Simple reactive counter component
//
// This example demonstrates:
// - Component structure
// - State management
// - Event handling
// - View templates
// - Scoped styling

component Counter {
    // Component state
    state count: i32 = 0;

    // Event handlers
    fn increment() {
        count = count + 1;
    }

    fn decrement() {
        count = count - 1;
    }

    fn reset() {
        count = 0;
    }

    // View template
    view {
        <div class="counter">
            <h1>"Counter Example"</h1>

            <div class="display">
                <div class="count-value">{count}</div>
                <div class="count-label">"Current Count"</div>
            </div>

            <div class="buttons">
                <button class="btn btn-decrement" on:click={decrement}>
                    "-"
                </button>

                <button class="btn btn-reset" on:click={reset}>
                    "Reset"
                </button>

                <button class="btn btn-increment" on:click={increment}>
                    "+"
                </button>
            </div>

            <div class="info">
                {if count == 0 {
                    <p class="status">"Counter is at zero"</p>
                } else if count > 0 {
                    <p class="status positive">"Positive: " {count}</p>
                } else {
                    <p class="status negative">"Negative: " {count}</p>
                }}
            </div>
        </div>
    }

    // Scoped styles
    style {
        .counter {
            max-width: 400px;
            margin: 2rem auto;
            padding: 2rem;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        h1 {
            margin: 0 0 2rem 0;
            color: #333;
            font-size: 1.8rem;
            font-weight: 600;
        }

        .display {
            margin: 2rem 0;
            padding: 2rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 8px;
            color: white;
        }

        .count-value {
            font-size: 4rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        .count-label {
            font-size: 0.9rem;
            opacity: 0.9;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .buttons {
            display: flex;
            gap: 1rem;
            margin: 2rem 0;
        }

        .btn {
            flex: 1;
            padding: 1rem;
            font-size: 1.2rem;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            color: white;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn-increment {
            background: #10b981;
        }

        .btn-increment:hover {
            background: #059669;
        }

        .btn-decrement {
            background: #ef4444;
        }

        .btn-decrement:hover {
            background: #dc2626;
        }

        .btn-reset {
            background: #6b7280;
        }

        .btn-reset:hover {
            background: #4b5563;
        }

        .info {
            margin-top: 2rem;
            padding: 1rem;
            background: #f3f4f6;
            border-radius: 8px;
        }

        .status {
            margin: 0;
            font-size: 1rem;
            color: #6b7280;
        }

        .status.positive {
            color: #10b981;
            font-weight: 600;
        }

        .status.negative {
            color: #ef4444;
            font-weight: 600;
        }
    }
}

// Entry point - mount the Counter component
fn main() {
    let counter = Counter {};
    mount(counter, "app");
}
