{
  "name": "diagramlab",
  "version": "0.1.0",
  "private": true,
  "description": "Dedicated Mermaid IDE with AI support",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "cd prisma && prisma migrate dev",
    "db:generate": "cd prisma && prisma generate",
    "db:studio": "cd prisma && prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "@types/node": "^22.10.1"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
